# Power-Grid Fault Big-Data Analytics Environment Configuration
PROJECT_TITLE="Power-Grid Fault Big-Data Analytics"
STUDENT_NAME="MARUMUDI GEORGE MULLAR"
PROJECT_GUIDE="Mr. R. SriRamu"

# Database Configuration
DATABASE_URL=sqlite:///power_grid.db

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501

# Streaming Mode ("local" or "kafka")
STREAMING_MODE=local

# Kafka Broker Configuration (Optional)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=powergrid.sensor.telemetry
KAFKA_TOPIC_FAULTS=powergrid.fault.monitoring
KAFKA_TOPIC_PROCESSED=powergrid.processed.data
KAFKA_CONSUMER_GROUP=powergrid_analytics_group

# Simulation Parameters
SIMULATION_INTERVAL_SEC=1.0
FAULT_INJECTION_PROBABILITY=0.25
